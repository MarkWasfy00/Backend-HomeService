node_modules
dist

# Keep environment variables out of version control
.env

# Prisma Client is generated from prisma/schema.prisma
/src/generated/prisma

# Files uploaded at runtime - kept out of git.
#
# Anchored with a leading and trailing slash, and both matter: a bare `uploads`
# matches *any* directory of that name at any depth, which silently excluded
# the whole src/modules/uploads/ source module and left master unable to
# compile from a clean checkout. This form matches only the folder at the root,
# which is the one holding the files.
/uploads/
