# Installed inside the image instead - see the comment at the top of Dockerfile.
node_modules
dist

# Regenerated by `prisma generate` during the build.
src/generated

# Files uploaded at runtime. Nothing COPYs them, so this changes no layer - but
# without it the whole folder is shipped to the docker daemon as build context
# on every build, and on a server that has been taking documents for a while
# that is gigabytes for nothing.
#
# Anchored: a bare `uploads` would also match src/modules/uploads/ and drop the
# storage module out of the build, exactly the way it fell out of git.
/uploads/

# Secrets stay out of the image; the app gets its configuration from
# docker-compose.yml, and dotenv leaves existing variables alone.
.env

.git
.gitignore
.claude
.agents
docs
README.md
Dockerfile
.dockerignore
docker-compose.yml
