# Copy to .env and fill in your own values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeservice?schema=public"

# Password for the `appuser` role, used by docker-compose.yml when the app
# and migrate containers connect to the host's Postgres via host.docker.internal.
DB_PASSWORD="change-me"

# Remote database with a self-signed certificate? Write sslmode the libpq way,
# which is what Prisma Studio and the CLI expect; src/core/db-url.ts converts
# it for node-postgres, which would otherwise reject the certificate.
# DATABASE_URL="postgresql://user:pass@host:5432/appdb?sslmode=require"
PORT=3000
NODE_ENV=development

# Signs every JWT. Use your own, at least 32 characters, and never commit it -
# anyone holding it can mint a token for any account, including an admin.
# Generate one with:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET="change-me-to-at-least-32-random-characters"

# Optional, these are the defaults. The access token is short because it cannot
# be revoked before it expires; the refresh token is long because renewing it
# is the only alternative to sending another SMS.
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=30
